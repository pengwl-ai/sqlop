MySQL,"CREATE OR REPLACE FUNCTION bst01(id integer)
    RETURNS INTEGER
    LANGUAGE plpgsql
  AS
  $$
  declare
    count integer;
  begin
    count = (select
               count(*)
             FROM  t_user a
             where a.user_id=id);
    return count;
  end;
$$",成功,,,t_user,"a, count, count(*, id, return, user_id"
MySQL,"create or replace function  getRcord2() RETURNS  text  AS $$
    declare
       rec record;
       v_text text;
       c_tmp cursor  for select * from tmp;
    begin
        v_text:='';
       open c_tmp;
       loop
           fetch  c_tmp into rec;
           exit when not FOUND;
           v_text:=v_text||','||rec.name;
       end loop;
       close c_tmp;
    return v_text;
    end;
    $$ language plpgsql;",成功,,,"tmp, rec",
MySQL,"CREATE OR REPLACE FUNCTION public.f_loop_insert(i_k integer[], i_v text[])
    RETURNS void
    LANGUAGE plpgsql
    STRICT
   AS $function$
   declare 
     i_length int := array_length(i_k,1); 
     i int;
     s timestamp;
     e timestamp;
   begin 
     s := clock_timestamp(); 
     raise notice 'start: %', s;
     for i in 1..i_length loop
       insert into test values (i_k[i], i_v[i]); 
     end loop;
     e := clock_timestamp(); 
     raise notice 'end: %, %', e, e-s; 
   end;
   $function$;",成功,,,test,
MySQL,"CREATE OR REPLACE FUNCTION gettable(rows integer)
    RETURNS TABLE(col1 INTEGER, col2 TEXT)
    AS $$
    BEGIN
      RETURN QUERY SELECT i * 2, i || '_text'
        FROM generate_series(1, rows, 1) as t(i);
    END;
    $$ LANGUAGE PLPGSQL;",成功,,,generate_series,"i * 2, i || '_text'"
MySQL,"create or replace function test_case(score integer)
    returns varchar as
$ty$
declare
    ty varchar;
begin
    case
        when score between 0 and 60 then ty = (select name from tmp limit 1);
        when score between 60 and 80 then ty = (select user_name from t_user limit 1);
        when score between 80 and 100 then ty = ((select class_name from t_class limit 1));
        else ty = 'no select';
        end case;
    return ty;
end;
$ty$ language plpgsql;",成功,,,"tmp, t_user, t_class",name
MySQL,"create or replace FUNCTION test_sql_scheam.ger_ref(refcursor) RETURNS refcursor AS
$$
BEGIN
 OPEN $1 FOR SELECT name FROM test_sql_scheam.tmp;
 RETURN $1;
END;
$$ LANGUAGE plpgsql;

BEGIN;
SELECT ger_ref('funccursor');
FETCH ALL IN funccursor;
COMMIT;",成功,,,test_sql_scheam.tmp,name
