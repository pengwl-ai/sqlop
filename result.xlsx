MySQL,CREATE OR REPLACE FUNCTION test_case(score integer) RETURNS varchar AS $ty$ DECLARE ty varchar; BEGIN CASE WHEN score BETWEEN 0 AND 60 THEN ty = (SELECT name FROM tmp LIMIT 1); WHEN score BETWEEN 60 AND 80 THEN ty = (SELECT user_name FROM t_user LIMIT 1); WHEN score BETWEEN 80 AND 100 THEN ty = (SELECT class_name FROM t_class LIMIT 1); ELSE ty = 'no select'; END CASE; RETURN ty; END; $ty$ LANGUAGE plpgsql,成功,,,"t_class, t_user, tmp",name
